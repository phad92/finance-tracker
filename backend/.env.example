PROJECT_NAME="Investment & Wealth Intelligence Platform"
VERSION="1.1.0"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="super_secret_jwt_key_change_in_production_min_32_chars_long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_PUBLIC_REGISTRATION=True
DOCS_ENABLED=True
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=30

# Default Reporting Currency
DEFAULT_REPORTING_CURRENCY="GHS"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secret_change_me"
POSTGRES_DB="finance_tracker"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# AI & Macro Providers (Optional - falls back gracefully to local quantitative synthesis when empty)
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
FRED_API_KEY=""

