# Production Environment Variables for Hetzner VPS (docker-compose.prod.yml)
# Copy to .env.prod and replace all placeholder secrets before deploying.

APP_DOMAIN=wealth.example.com
ACME_EMAIL=admin@example.com

ENVIRONMENT=production
DEBUG=False
DOCS_ENABLED=False
ALLOW_PUBLIC_REGISTRATION=False

# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
DEFAULT_REPORTING_CURRENCY=GHS

POSTGRES_DB=finance_tracker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD

BACKEND_CORS_ORIGINS=["https://wealth.example.com"]

# Optional Cloud AI & Economic Data Keys
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
FRED_API_KEY=


